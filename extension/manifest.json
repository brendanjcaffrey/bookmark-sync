{
  "manifest_version": 3,
  "name": "Bookmark Sync",
  "version": "1.5",
  "permissions": [
    "bookmarks",
    "nativeMessaging",
    "notifications",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Sync Bookmarks",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "commands": {
    "add-current-tab-other": {
      "description": "Save the current tab to Other Bookmarks"
    },
    "add-current-tab-bar": {
      "description": "Save the current tab to the Bookmarks Toolbar"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bs@jcaffrey.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
